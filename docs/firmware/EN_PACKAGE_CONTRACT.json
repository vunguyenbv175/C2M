  "adas_upgrade_sh_role": "Second-stage SD-card script run on-device AFTER U-Boot flash (md5-checks inner .bin, extracts image.tar, backs up customer configs, triggers reboot). NOT the U-Boot script at inner offset 0.",
  "upgrade_script_text": "\n# File Partition: cis.es\nsysVer 20230803193750\nfatload mmc 0 0x21000000 $(SdUpgradeImage) 0x5c00 0x4000\nfatload mmc 0 0x21800000 $(SdUpgradeImage) 0x200 0xa000\nwritecis 0x21000000 0x21800000 0 0 0 5\n\n# File Partition: set_partition.es\nmtdparts del CIS\nsetenv mtdparts $(mtdparts),0x20000(KEY_CUST),0x500000(MISC),0x20000(ADAS_CUST),-(ubi0)\nsaveenv\n\n# File Partition: ipl.es\nfatload mmc 0 0x21000000 $(SdUpgradeImage) 0x6180 0xb000\nnand erase.part IPL0\nnand write.e 0x21000000 IPL0 0x6180\n\n# File Partition: ipl_cust.es\nfatload mmc 0 0x21000000 $(SdUpgradeImage) 0x5eb0 0x12000\nnand erase.part IPL_CUST0\nnand write.e 0x21000000 IPL_CUST0 0x5EB0\nnand erase.part IPL_CUST1\nnand write.e 0x21000000 IPL_CUST1 0x5EB0\n\n# File Partition: uboot.es\nfatload mmc 0 0x21000000 $(SdUpgradeImage) 0x48a44 0x18000\nnand erase.part UBOOT0\nnand write.e 0x21000000 UBOOT0 0x48A44\nnand erase.part UBOOT1\nnand write.e 0x21000000 UBOOT1 0x48A44\n\n# File Partition: kernel.es\nfatload mmc 0 0x21000000 $(SdUpgradeImage) 0x22691f 0x61000\nnand erase.part KERNEL\nnand write.e 0x21000000 KERNEL 0x22691F\nnand erase.part RECOVERY\nnand write.e 0x21000000 RECOVERY 0x22691F\n\n# File Partition: rootfs.es\nfatload mmc 0 0x21000000 $(SdUpgradeImage) 0x841d6b 0x288000\nnand erase.part rootfs\nnand write.e 0x21000000 rootfs 0x841D6B\nsetenv initrd_high 0x21000000\nsetenv initrd_size ${filesize}\nsetenv initrd_block 110\n\n# File Partition: ubi0.es\nnand erase.part ubi0\n\n# File Partition: miservice.es\nubi part ubi0\nubi create miservice 0x500000\nfatload mmc 0 0x21000000 $(SdUpgradeImage) 0x193000 0xaca000\nubi write 0x21000000 miservice 0x193000\n\n# File Partition: customer.es\nubi part ubi0\nubi create customer 0x5000000\nfatload mmc 0 0x21000000 $(SdUpgradeImage) 0x25e7000 0xc5d000\nubi write 0x21000000 customer 0x25E7000\n\n# File Partition: misc.es\nfatload mmc 0 0x21000000 $(SdUpgradeImage) 0x200000 0x3244000\nnand erase.part MISC\nnand write.e 0x21000000 MISC 0x200000\n\n# File Partition: oneed_cust.es\nubi part ubi0\nubi create oneed_cust 0x600000\nfatload mmc 0 0x21000000 $(SdUpgradeImage) 0x364000 0x3444000\nubi write 0x21000000 oneed_cust 0x364000\n\n# File Partition: set_config\nsetenv bootargs ubi.mtd=ubi0,2048 rootfstype=ramfs initrd=0x21000000,0xc00000 LX_MEM=0x3ffe0000 mma_heap=mma_heap_name0,miu=0,sz=0x1f000000 mma_memblock_remove=1 cma=2M@0x23800000 loglevel=3 $(mtdparts)\nsetenv bootcmd ' bootlogo 0 0 0 0; nand read.e 0x22000000 KERNEL 0x300000; nand read.e 0x21000000 rootfs 0xc00000; bootm 0x22000000;nand read.e 0x22000000 RECOVERY 0x300000; nand read.e 0x21000000 rootfs 0xc00000; bootm 0x22000000\nsaveenv\nreset\n% <- this is end of script symbol",
