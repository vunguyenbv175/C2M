# C2M baseline EXTRA_CFLAGS (single interface, SDIO, CFG80211).
# Derived from work/baseline/b/Makefile by derive_flags.py (patched
# platform = CONFIG_PLATFORM_C2M, RK3188 default disabled).
# Not live-pinned (source defaults retained): CONFIG_AP_MODE,
# CONFIG_MP_INCLUDED, CONFIG_BT_COEXIST, CONFIG_EFUSE_CONFIG_FILE,
# CONFIG_IEEE80211W, CONFIG_LAYER2_ROAMING, CONFIG_BR_EXT,
# CONFIG_RTW_NAPI, CONFIG_RTW_GRO, CONFIG_RTW_DEBUG, CONFIG_PROC_DEBUG.
# Explicitly OFF (not in live drv_cfg): CONFIG_P2P, CONFIG_WIFI_MONITOR,
# CONFIG_TDLS, CONFIG_MCC_MODE, CONFIG_WOWLAN, CONFIG_RTW_ANDROID.
-DCONFIG_AP_MODE
-DCONFIG_MP_INCLUDED
-DCONFIG_POWER_SAVING
-DCONFIG_BT_COEXIST
-DCONFIG_EFUSE_CONFIG_FILE
-DEFUSE_MAP_PATH="/system/etc/wifi/wifi_efuse_8821cs.map"
-DWIFIMAC_PATH="/data/wifimac.txt"
-DCONFIG_LOAD_PHY_PARA_FROM_FILE
-DREALTEK_CONFIG_PATH="/lib/firmware/"
-DCONFIG_TXPWR_BY_RATE=1
-DCONFIG_TXPWR_BY_RATE_EN=1
-DCONFIG_TXPWR_LIMIT=1
-DCONFIG_TXPWR_LIMIT_EN=0
-DCONFIG_RTW_ADAPTIVITY_EN=0
-DCONFIG_RTW_ADAPTIVITY_MODE=0
-DCONFIG_IEEE80211W
-DCONFIG_LAYER2_ROAMING
-DCONFIG_ROAMING_FLAG=0x3
-DHIGH_ACTIVE_HST2DEV=0
-DCONFIG_RTW_SDIO_PM_KEEP_POWER
-DCONFIG_BR_EXT
-DCONFIG_BR_EXT_BRNAME="br0"
-DCONFIG_RTW_NAPI
-DCONFIG_RTW_GRO
-DCONFIG_RTW_NETIF_SG
-DCONFIG_RTW_DEBUG
-DRTW_LOG_LEVEL=0
-DCONFIG_PROC_DEBUG
-DCONFIG_RTW_UP_MAPPING_RULE=0
-DDM_ODM_SUPPORT_TYPE=0x04
-DCONFIG_LITTLE_ENDIAN
-DCONFIG_IOCTL_CFG80211
-DRTW_USE_CFG80211_STA_EVENT
